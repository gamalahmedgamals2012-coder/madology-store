{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    { "source": "/auth/(.*)", "destination": "/api/index.js" },
    { "source": "/location/(.*)", "destination": "/api/index.js" },
    { "source": "/products/(.*)", "destination": "/api/index.js" },
    { "source": "/orders/(.*)", "destination": "/api/index.js" },
    { "source": "/order", "destination": "/api/index.js" },
    { "source": "/admin/(.*)", "destination": "/api/index.js" },
    { "source": "/health", "destination": "/api/index.js" }
  ]
}
